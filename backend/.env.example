APP_ENV=dev
DEBUG=true
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
FAISS_INDEX_DIR=./data/faiss

# auto: 有 Key 用真实模型，没有 Key 自动降级到 Mock
PROVIDER_MODE=auto

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
TEXT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4v-flash
ZHIPU_TEXT_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-2

# 模型调用容错
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=1
MODEL_RETRY_BACKOFF=0.5

# 风险规则版本，历史研判结果据此追溯
RISK_RULE_VERSION=risk-engine-v1

# 真实模型启用“检索证据二次研判”；Mock 模式下自动跳过
REFINE_WITH_EVIDENCE=true

# 检索重排：true 时执行 Vector Top-K → 规则重排 → Top-N
RERANKER_ENABLED=true
RERANKER_TOP_K=5

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 留空则不启用鉴权；部署时建议设置强随机值
API_BEARER_TOKEN=
MAX_IMAGES=3
MAX_FOLLOWUPS=2
