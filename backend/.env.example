APP_ENV=dev
DEBUG=true
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
FAISS_INDEX_DIR=./data/faiss

# auto: 有 Key 用真实模型，没有 Key 自动降级到 Mock
PROVIDER_MODE=auto

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
TEXT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4v-flash
ZHIPU_TEXT_MODEL=glm-4-flash
ZHIPU_EMBEDDING_MODEL=embedding-2

# 模型调用容错
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=1
MODEL_RETRY_BACKOFF=0.5

# 风险规则版本，历史研判结果据此追溯
RISK_RULE_VERSION=risk-engine-v1

# 真实模型启用“检索证据二次研判”；Mock 模式下自动跳过
REFINE_WITH_EVIDENCE=true

# 检索重排：true 时执行 Vector Top-K → 规则重排 → Top-N
RERANKER_ENABLED=true
RERANKER_TOP_K=5

# 核心模块开关（保持默认即可；消融评测会按变体覆盖这些值）
ENABLE_RISK_ENGINE=true
ENABLE_EVIDENCE_RAG=true

# B3：研判执行模式。sync = 请求内完成（默认）；async = 202 + 任务表 + 轮询
WORKFLOW_MODE=sync
# async 模式的 LangGraph checkpoint 库（追问断点恢复/崩溃恢复）
# LANGGRAPH_CHECKPOINT_PATH=backend/data/langgraph.db
# 僵尸任务清扫阈值（分钟）
JOB_STALE_MINUTES=10
# Idempotency-Key 重放窗口（小时）
IDEMPOTENCY_TTL_HOURS=24
# 整改 AI 比对去重窗口（分钟，同状态窗口内复用缓存）
COMPARE_DEDUP_MINUTES=5

# B5：LLM 并发与预算（跨请求共享线程池上限；0 = 不限预算）
MAX_CONCURRENT_LLM_CALLS=4
LLM_QUEUE_TIMEOUT_SECONDS=60
DAILY_TOKEN_BUDGET=0
# 演示模式置信度加成：默认关。开启后 mock 演示更流畅，但会污染评测数字
MOCK_DEMO_BOOST=false
# B5：检索参数收敛
RETRIEVAL_TOP_K=5
RERANK_VECTOR_WEIGHT=0.4
RERANK_LEXICAL_WEIGHT=0.4
RERANK_METADATA_WEIGHT=0.2

# B4：认证模式。none = 本地开发不鉴权；token = 静态 Bearer（兼容旧部署）；
# jwt = 用户体系。必须设置独立随机 AUTH_JWT_SECRET（至少 32 字节）；禁止复制占位密钥。
AUTH_MODE=none
AUTH_JWT_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=720
# 签名图片 URL 的有效期（分钟，auth 模式下 /uploads 走短期签名）
UPLOAD_URL_TTL_MINUTES=60
# 限流（默认关闭；生产建议开启）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_ASSESSMENTS_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AUTH_MODE=token 时必须非空且无首尾空白；none 才是明确关闭鉴权。
API_BEARER_TOKEN=
MAX_IMAGES=3
MAX_FOLLOWUPS=2
# 单张图片/文档大小上限（字节）；与代码内常量一致
MAX_FILE_BYTES=10485760
MAX_DOCUMENT_BYTES=20971520

# Hash 检索降级后，两次真实 embedding 恢复探测的最小间隔（秒）
EMBEDDING_RECOVERY_SECONDS=60
